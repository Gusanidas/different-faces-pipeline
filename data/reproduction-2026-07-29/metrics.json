      "prompts": [
        {
          "id": "mario",
          "text": "Mario, from Albacete, from a working-class family, works as a delivery driver hauling boxes all day and does judo on weekends; weather-beaten sun-reddened skin, a small scar through one eyebrow, a nose broken once and healed crooked, tired easygoing look"
        },
        {
          "id": "borja",
          "text": "Borja, from Madrid, from a wealthy family, studied business administration and works as a consultant; clean well-groomed appearance, smooth cared-for skin, faint confident smirk, crisp shirt collar just visible"
        },
        {
          "id": "iker",
          "text": "Iker, from Bilbao, son of fishermen, works as a welder in a shipyard and climbs mountains on weekends; rugged wind-chapped ruddy skin, stern calm jaw, faint burn mark on the neck"
        },
        {
          "id": "ruben",
          "text": "Ruben, from Sevilla, working-class, waits tables in a bar in the old town and plays flamenco guitar at night; dark expressive deep-set eyes, a couple of days unshaven, quick warm half-grin"
        },
        {
          "id": "alvaro",
          "text": "Alvaro, from Valencia, middle-class, a high-school physical-education teacher and road cyclist; fit healthy glow, faint cyclist tan lines at the collar, crow's feet from squinting into the sun"
        },
        {
          "id": "nacho",
          "text": "Nacho, from Zaragoza, grew up on a farm, works as an agricultural engineer and hunts on weekends; broad honest face, deep field tan, sun-creased forehead, peeling sunburnt nose, plain steady expression"
        },
        {
          "id": "cristian",
          "text": "Cristian, from Murcia, working-class, labors in plastic greenhouses and races motocross; wiry frame, very dark leathery tan, two small scars on the cheek, intense narrow squinting eyes"
        },
        {
          "id": "guillermo",
          "text": "Guillermo, from Salamanca, from an academic family, a university history researcher who plays chess; wire-frame glasses, thoughtful slightly distracted look, pale indoor complexion beneath the tan"
        },
        {
          "id": "dani",
          "text": "Dani, from Malaga, working-class, a beach lifeguard and surf instructor; deep even beach tan, salt-dried skin, scatter of freckles across the nose, relaxed sunny squint"
        },
        {
          "id": "unai",
          "text": "Unai, from Pamplona, middle-class, a hospital nurse who runs marathons; lean sinewy build, calm tired eyes with faint shadows, kind steady expression"
        },
        {
          "id": "sergio",
          "text": "Sergio, from A Coruna, a fisherman who plays for the village football team; wind-reddened cheeks, chipped front tooth just showing, weather-beaten salt-worn skin, broad plain face"
        },
        {
          "id": "marcos",
          "text": "Marcos, from Toledo, a motorcycle mechanic who restores old bikes; faint grease smudge on the temple, small scar on the cheek, tattoo edge on the neck, wry knowing half-smile"
        }
      ]
    }
